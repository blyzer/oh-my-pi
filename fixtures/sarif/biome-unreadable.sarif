{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Biome",
          "informationUri": "https://biomejs.dev",
          "rules": [
            {
              "id": "internalError/io",
              "shortDescription": {
                "text": ""
              },
              "helpUri": ""
            },
            {
              "id": "lint/correctness/noUnusedVariables",
              "shortDescription": {
                "text": "Disallow unused variables."
              },
              "helpUri": "https://biomejs.dev/linter/rules/no-unused-variables"
            },
            {
              "id": "lint/suspicious/noDebugger",
              "shortDescription": {
                "text": "Disallow the use of `debugger`"
              },
              "helpUri": "https://biomejs.dev/linter/rules/no-debugger"
            },
            {
              "id": "lint/suspicious/noDoubleEquals",
              "shortDescription": {
                "text": "Require the use of `===` and `!==`."
              },
              "helpUri": "https://biomejs.dev/linter/rules/no-double-equals"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "lint/correctness/noUnusedVariables",
          "level": "warning",
          "message": {
            "text": "This variable unused is unused."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/private/tmp/sarif-work/biome/outcomes.js"
                },
                "region": {
                  "startLine": 2,
                  "startColumn": 9,
                  "endLine": 2,
                  "endColumn": 15
                }
              }
            }
          ]
        },
        {
          "ruleId": "internalError/io",
          "level": "error",
          "message": {
            "text": "No such file or directory (os error 2)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/private/tmp/sarif-work/biome/missing.js"
                }
              }
            }
          ]
        },
        {
          "ruleId": "lint/suspicious/noDoubleEquals",
          "level": "error",
          "message": {
            "text": "Using == may be unsafe if you are relying on type coercion."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/private/tmp/sarif-work/biome/outcomes.js"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 9,
                  "endLine": 3,
                  "endColumn": 11
                }
              }
            }
          ]
        },
        {
          "ruleId": "lint/suspicious/noDebugger",
          "level": "error",
          "message": {
            "text": "This is an unexpected use of the debugger statement."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/private/tmp/sarif-work/biome/outcomes.js"
                },
                "region": {
