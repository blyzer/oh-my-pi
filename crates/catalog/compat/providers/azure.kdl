// Provider-wire compat for "azure"; regenerated from the frozen census using deployment contract selectors.

provider "azure" priority=-1 {
	// Hosts speaking the OpenAI wire; a lineage rule (Claude or Gemini behind a
	// gateway) speaks its own tier vocabulary and wins on priority.
	service-tier-family "openai"
	class "openai" {
		thinking-mode "effort"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "codex-mini" "gpt-chat-latest" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gpt-5.1-codex" "gpt-5.1-codex-max" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gpt-5.1-codex-mini" {
		thinking-efforts "medium" "high"
	}
}
