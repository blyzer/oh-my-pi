<mxfile host="app.diagrams.net" type="device"><diagram name="resume" id="resume"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="670" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="die" value="&lt;b&gt;the run dies mid-flight&lt;/b&gt;&lt;br&gt;crash · kill -9 · host shutdown · SIGTERM&lt;br&gt;attempt 2 of 3 was in flight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="380" height="70" as="geometry"/></mxCell><mxCell id="disk" value="&lt;b&gt;what survives on disk&lt;/b&gt;&lt;br&gt;trace/events.bin + strings.bin&lt;br&gt;envelopes/&amp;lt;phase&amp;gt;.json · request.txt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="380" height="84" as="geometry"/></mxCell><mxCell id="nd" value="Run state lives in ~/.omp/agent/adw/&amp;lt;adwId&amp;gt;/, NOT the session dir — a crashed run is resumed by a NEW process, so session-keyed state would make it unfindable." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="300" height="84" as="geometry"/></mxCell><mxCell id="cmd" value="/adw resume ship adw-1574a6b1b268f57c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="380" height="44" as="geometry"/></mxCell><mxCell id="replay" value="&lt;b&gt;Run::resume(adw_id, root, workflow, trace_dir)&lt;/b&gt;&lt;br&gt;replays events.bin to rebuild:&lt;br&gt;&lt;br&gt;cursor = count of PASSED phases&lt;br&gt;attempts = rejections against the in-flight phase&lt;br&gt;handoff = last accepted envelope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="380" height="110" as="geometry"/></mxCell><mxCell id="cont" value="&lt;b&gt;continues at the phase that was in flight&lt;/b&gt;&lt;br&gt;with the budget it had already spent&lt;br&gt;completed phases are not redone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="380" height="70" as="geometry"/></mxCell><mxCell id="ev" value="&lt;b&gt;run_resumed&lt;/b&gt; trace record&lt;br&gt;a terminal record is not necessarily&lt;br&gt;the end of the story" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="480" width="300" height="70" as="geometry"/></mxCell><mxCell id="gr" value="resume REFUSES, up front, before any I/O" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="520" height="190" as="geometry"/></mxCell><mxCell id="r1" value="a trace from another workflow — replaying a plan against a different pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="285" width="480" height="34" as="geometry"/></mxCell><mxCell id="r2" value="a run that already finished or was accepted — nothing left to continue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="329" width="480" height="34" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;isolation: true&lt;/b&gt; — the sandbox died with the run; resuming into a fresh one&lt;br&gt;would silently restart completed phases from the base commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="373" width="480" height="50" as="geometry"/></mxCell><mxCell id="nr" value="The driver writes run_finished on a crash too, so a reader can tell a dead run from a running one. Only an ACCEPTED run has nothing left to resume." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="480" y="580" width="520" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="die" target="disk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="disk" target="cmd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="cmd" target="replay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="replay" target="cont"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="cont" target="ev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=1;exitY=0.5;entryX=0;entryY=0.25;dashed=1;" edge="1" parent="1" source="cmd" target="gr"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>