<mxfile host="app.diagrams.net" type="device"><diagram name="isolation" id="isolation"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cfg" value="&lt;b&gt;isolation: true&lt;/b&gt; in the workflow yml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="340" y="20" width="320" height="44" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;your checkout&lt;/b&gt;&lt;br&gt;the real working tree&lt;br&gt;&lt;i&gt;never mutated mid-run&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="240" height="70" as="geometry"/></mxCell><mxCell id="mat" value="&lt;b&gt;ensureIsolation()&lt;/b&gt;&lt;br&gt;materialised copy: APFS clone · reflink · overlay&lt;br&gt;whatever the platform actually offers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="320" height="70" as="geometry"/></mxCell><mxCell id="sand" value="&lt;b&gt;workRoot = sandbox&lt;/b&gt;&lt;br&gt;ONE sandbox for the&lt;br&gt;WHOLE workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="240" height="70" as="geometry"/></mxCell><mxCell id="nw" value="Not one per spawn: the plan phase writes files that the build phase reads and gates verify on disk. Per-spawn isolation would throw away exactly the continuity phases depend on." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="290" height="76" as="geometry"/></mxCell><mxCell id="phases" value="every phase runs there — agent, code and fusion alike" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="250" width="320" height="54" as="geometry"/></mxCell><mxCell id="d" value="run accepted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="160" height="70" as="geometry"/></mxCell><mxCell id="apply" value="&lt;b&gt;diff applies to your checkout&lt;/b&gt;&lt;br&gt;but only after git says it applies cleanly&lt;br&gt;&lt;br&gt;&lt;i&gt;a half-applied patch is worse than none&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="440" width="380" height="84" as="geometry"/></mxCell><mxCell id="keep" value="&lt;b&gt;checkout never touched&lt;/b&gt;&lt;br&gt;work preserved at runDir/&amp;lt;adwId&amp;gt;.patch&lt;br&gt;&lt;br&gt;&lt;i&gt;a rejected run is recoverable, not lost&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="380" height="84" as="geometry"/></mxCell><mxCell id="nested" value="nested-repo patches captured and applied&lt;br&gt;&lt;b&gt;only after&lt;/b&gt; the root landed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="320" height="54" as="geometry"/></mxCell><mxCell id="nt" value="Non-fatal but never silent: a nested repo that refuses its patch surfaces as nestedWarnings." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="556" width="330" height="60" as="geometry"/></mxCell><mxCell id="typo" value="&lt;b&gt;isolaton: true&lt;/b&gt; → the whole file is REJECTED · a misspelled safety flag must never read as false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="960" height="44" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="cfg" target="mat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="repo" target="mat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="mat" target="sand"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="sand" target="phases"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="phases" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d" target="apply"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d" target="keep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="apply" target="nested"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>