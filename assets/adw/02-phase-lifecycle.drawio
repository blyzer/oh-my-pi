<mxfile host="app.diagrams.net" type="device"><diagram name="phase-lifecycle" id="phase-lifecycle"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="&lt;b&gt;phase_started&lt;/b&gt; · attempt N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="340" height="40" as="geometry"/></mxCell><mxCell id="turn" value="&lt;b&gt;agent phase&lt;/b&gt; — owner comes from the roster&lt;br&gt;(.omp/agents/*.md), never a raw model&lt;br&gt;&lt;br&gt;prompt = request + handoff + ENVELOPE_CONTRACT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="340" height="74" as="geometry"/></mxCell><mxCell id="envelope" value="&lt;b&gt;final message must end with ONE JSON object&lt;/b&gt;&lt;br&gt;&lt;br&gt;{ &amp;quot;status&amp;quot;: &amp;quot;success&amp;quot; | &amp;quot;fail&amp;quot;,&lt;br&gt;&amp;nbsp; &amp;quot;summary&amp;quot;: &amp;quot;one line on what you did&amp;quot;,&lt;br&gt;&amp;nbsp; &amp;quot;artifacts&amp;quot;: [&amp;quot;repo-relative/path/you/wrote&amp;quot;],&lt;br&gt;&amp;nbsp; &amp;quot;notes_for_next_agent&amp;quot;: &amp;quot;...&amp;quot; }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;spacingLeft=12;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="194" width="340" height="116" as="geometry"/></mxCell><mxCell id="gates" value="&lt;b&gt;gates — evidence, not silence&lt;/b&gt;&lt;br&gt;artifacts_exist · files_non_empty&lt;br&gt;every claimed path checked against the filesystem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="340" width="340" height="74" as="geometry"/></mxCell><mxCell id="d1" value="all gates pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="440" width="200" height="80" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;phase_finished&lt;/b&gt;&lt;br&gt;envelope persisted to envelopes/&amp;lt;phase&amp;gt;.json&lt;br&gt;→ becomes the next phase's handoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="450" width="300" height="60" as="geometry"/></mxCell><mxCell id="rej" value="&lt;b&gt;phase_rejected&lt;/b&gt; — violations name the file&lt;br&gt;&amp;quot;docs/x.md was claimed but does not exist&amp;quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="550" width="340" height="54" as="geometry"/></mxCell><mxCell id="d2" value="attempt &amp;lt; maxAttempts?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="630" width="200" height="80" as="geometry"/></mxCell><mxCell id="corr" value="&lt;b&gt;correction into the SAME session&lt;/b&gt;&lt;br&gt;runSubagentFollowUpTurn&lt;br&gt;&lt;br&gt;keeps full history · costs one message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="250" height="80" as="geometry"/></mxCell><mxCell id="halt" value="&lt;b&gt;run halts · accepted = false&lt;/b&gt;&lt;br&gt;with isolation: your checkout was never touched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="740" width="340" height="54" as="geometry"/></mxCell><mxCell id="n1" value="Why the loop and not a fresh spawn: a respawned agent has no memory of what it just claimed, so it re-derives the same wrong answer. The retried seat already remembers its rejected attempt.

Default maxAttempts = 3, minimum 1." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="720" y="560" width="320" height="120" as="geometry"/></mxCell><mxCell id="n2" value="Gates run in Rust, AFTER the phase — they read the filesystem, so an agent cannot talk its way past one." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="720" y="350" width="320" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="start" target="turn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="turn" target="envelope"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="envelope" target="gates"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="gates" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="ok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="d1" target="rej"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="rej" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d2" target="corr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="retry — same seat, same context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="corr" target="turn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="d2" target="halt"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>