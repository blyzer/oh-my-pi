<mxfile host="app.diagrams.net" type="device"><diagram name="fusion-panel" id="fusion-panel"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q" value="&lt;b&gt;one question&lt;/b&gt; — request + phase instructions&lt;br&gt;every seat gets the identical prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="400" height="50" as="geometry"/></mxCell><mxCell id="gp" value="panel — READ-ONLY, answers in parallel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="620" height="150" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;seat: reviewer&lt;/b&gt;&lt;br&gt;opus&lt;br&gt;&lt;br&gt;tools: read · grep · glob · yield&lt;br&gt;&lt;i&gt;no write/edit/bash&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="65" y="150" width="180" height="90" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;seat: scout&lt;/b&gt;&lt;br&gt;gpt&lt;br&gt;&lt;br&gt;tools: read · grep · glob · yield&lt;br&gt;&lt;i&gt;no write/edit/bash&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="150" width="180" height="90" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;seat: planner&lt;/b&gt;&lt;br&gt;gemini&lt;br&gt;&lt;br&gt;tools: read · grep · glob · yield&lt;br&gt;&lt;i&gt;no write/edit/bash&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455" y="150" width="180" height="90" as="geometry"/></mxCell><mxCell id="nc" value="Different models is the point — one model's blind spot is another's obvious answer.

Concurrency ceiling: task.maxConcurrency (default 4). A 6-seat panel under 2 runs in waves." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="680" y="150" width="300" height="90" as="geometry"/></mxCell><mxCell id="op" value="&lt;b&gt;panel_opinion&lt;/b&gt; × N — one trace record per seat&lt;br&gt;a fusion phase is N comparable answers, not one opaque span" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="300" width="420" height="54" as="geometry"/></mxCell><mxCell id="labels" value="&lt;b&gt;labelled opinions&lt;/b&gt;, in the order the panel was declared&lt;br&gt;owner + model + text — never anonymised, never merged early" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="384" width="420" height="70" as="geometry"/></mxCell><mxCell id="fuser" value="&lt;b&gt;fuser — the only seat allowed to write&lt;/b&gt;&lt;br&gt;receives every opinion verbatim + ENVELOPE_CONTRACT&lt;br&gt;owns the envelope and the phase's artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="484" width="420" height="74" as="geometry"/></mxCell><mxCell id="gates" value="&lt;b&gt;gates&lt;/b&gt; — verify the fuser's claimed artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="588" width="420" height="50" as="geometry"/></mxCell><mxCell id="d" value="gates pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="668" width="220" height="76" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;phase_finished&lt;/b&gt;&lt;br&gt;the fused envelope becomes the handoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="675" width="330" height="60" as="geometry"/></mxCell><mxCell id="retry" value="&lt;b&gt;retry re-runs the FUSER ONLY&lt;/b&gt; — opinions are cached&lt;br&gt;the panel was not what was rejected; re-polling N models is&lt;br&gt;the most expensive way to change nothing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="520" height="70" as="geometry"/></mxCell><mxCell id="nf" value="Single-writer invariant: N readers may run at once, exactly one writer ever holds the checkout. That is what makes the parallelism safe." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="610" y="770" width="340" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=0.25;exitY=1;" edge="1" parent="1" source="q" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="q" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=0.75;exitY=1;" edge="1" parent="1" source="q" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=0.5;exitY=1;" edge="1" parent="1" source="s1" target="op"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="s2" target="op"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=0.5;exitY=1;" edge="1" parent="1" source="s3" target="op"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="op" target="labels"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="labels" target="fuser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="fuser" target="gates"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;" edge="1" parent="1" source="gates" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d" target="ok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="same question, one seat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="retry" target="fuser"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>