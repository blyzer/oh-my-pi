{
	"type": "module",
	"name": "@oh-my-pi/adw-web",
	"version": "18.1.15",
	"private": true,
	"description": "Trace viewer for omp AI developer workflows: decodes the binary phase log into a waterfall",
	"homepage": "https://omp.sh",
	"author": "Stencil Labs, Inc.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/adw-web"
	},
	"scripts": {
		"dev": "bun server.ts",
		"build": "rm -rf dist && bun build ./index.html --outdir=dist --minify --entry-naming=[hash].[ext] --chunk-naming=[hash].[ext] --asset-naming=[hash].[ext] && mv dist/*.html dist/index.html",
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '*.ts'",
		"test": "bun test"
	},
	"dependencies": {
		"@oh-my-pi/pi-natives": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
