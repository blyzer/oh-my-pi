{
	"type": "module",
	"name": "@oh-my-pi/omp-factory",
	"version": "0.1.0",
	"description": "Deterministic software-factory controller: durable workflows over managed OMP subagents",
	"homepage": "https://omp.sh",
	"author": "Stencil Labs, Inc.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/omp-factory"
	},
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"keywords": [
		"factory",
		"orchestration",
		"workflow",
		"extension"
	],
	"main": "./src/extension.ts",
	"types": "./src/extension.ts",
	"exports": {
		".": {
			"types": "./src/extension.ts",
			"import": "./src/extension.ts"
		}
	},
	"omp": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"scripts": {
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"test": "bun test",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt"
	},
	"dependencies": {
		"@oh-my-pi/pi-coding-agent": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	]
}
