#!/bin/sh
# omp-githooks: commit-msg
# Reject a commit whose subject line is longer than GIT_SUBJECT_MAX characters (default 72).
# Comment lines are ignored, like git does. Merge, Revert and fixup!/squash!/amend! subjects are
# generated by git and are exempt. `git commit --no-verify` skips this hook.
max=${GIT_SUBJECT_MAX:-72}
subject=$(grep -v '^#' "$1" | sed -n '/[^[:space:]]/{p;q;}')
case "$subject" in
	'Merge '* | 'Revert "'* | 'fixup! '* | 'squash! '* | 'amend! '*) exit 0 ;;
esac
# Count characters when a UTF-8 locale exists, bytes otherwise (which can only over-count).
loc=C
for l in C.UTF-8 en_US.UTF-8; do
	if locale -a 2>/dev/null | grep -qix "$l"; then loc=$l; break; fi
done
len=$(printf '%s' "$subject" | LC_ALL=$loc wc -m | tr -d ' ')
if [ "$len" -gt "$max" ]; then
	echo "commit-msg: the subject is $len characters, the limit is $max:" >&2
	echo "  $subject" >&2
	echo "Shorten it and move detail into the body." >&2
	exit 1
fi
