# Rust
/target/
**/*.rs.bk

# Vendored CPython: ~290 MB of build/install trees plus the derived
# stdlib.bin and pyo3-config.txt. Regenerate with crates/py/scripts/fetch-python.sh.
# No trailing slash: a worktree's `vendor` is a symlink to the main checkout's, which `/vendor/`
# would not ignore (and `bb remote` would mirror as a dangling link).
/vendor

# Node / JS
node_modules/
.omp/tools/node_modules/

# Bun transient build files and generated bundled binaries.
**/*.bun-build
/packages/coding-agent/binaries/
/packages/natives/native/*.node
/.bazelrc.user
# Python
__pycache__/
*.py[cod]
.venv/

# Editors & OS
.DS_Store
.idea/
.vscode/
*.swp
# Knowledge-base local rebuild products (regenerate via scripts/knowledge-base/)
/docs/knowledge-base/index.scip
/docs/knowledge-base/ast-lookup.json
/docs/knowledge-base/ast-lookup.min.json
/docs/knowledge-base/ast-lookup.min.json.gz
/docs/knowledge-base/by-crate-ast/

# Session scratch (plans, gap audits, research sandbox) — local-only
/.gap/
/.plan/
/elastic/
/*PLAN.md
.omp/artifacts/
.omp/local/
.omp/plans/
.omp/config.toml.lock
.omp/omp-*.md
dist/
